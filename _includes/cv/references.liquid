{% comment %}
  Site-specific reference renderer.
  Keep reference data structured in resume.json; this include owns the markup,
  while _sass/_custom-cv.scss owns presentation.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item cv-reference">
      {% if entry.icon %}
        <div class="cv-reference-main-icon">
          <i class="{{ entry.icon }}" aria-hidden="true"></i>
        </div>
      {% endif %}

      <div class="cv-reference-content">
        <strong class="cv-reference-name">
          {% if entry.url %}
            <a href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">{{ entry.name }}</a>
          {% else %}
            {{ entry.name }}
          {% endif %}
        </strong>

        {% if entry.reference or entry.email or entry.phone %}
          <div class="cv-reference-details">
            {% if entry.reference %}
              <div class="cv-reference-row">
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                <div class="cv-reference-lines">
                  {% if entry.reference.first %}
                    {% for reference_line in entry.reference %}
                      <span>{{ reference_line | markdownify | remove: '<p>' | remove: '</p>' }}</span>
                    {% endfor %}
                  {% else %}
                    <span>{{ entry.reference | markdownify | remove: '<p>' | remove: '</p>' }}</span>
                  {% endif %}
                </div>
              </div>
            {% endif %}

            {% if entry.email %}
              <div class="cv-reference-row">
                <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                <a href="mailto:{{ entry.email }}">{{ entry.email }}</a>
              </div>
            {% endif %}

            {% if entry.phone %}
              <div class="cv-reference-row">
                <i class="fa-solid fa-phone" aria-hidden="true"></i>
                <a href="tel:{{ entry.phone }}">{{ entry.phone }}</a>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
